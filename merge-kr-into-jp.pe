style = "TextItalic"
Print("Merge " + family_name + " " + style + "...")
# Open the base font (first font)
Open("build/PlemolJPConsole_NF/PlemolJPConsoleNF-" + style + ".ttf")
Print("Before changes:")
Print(" - Font name: " + $fontname)
Print(" - Family name: " + $familyname)
Print(" - Full name: " + $fullname)
# Merge the second font
MergeFonts("build/MonoplexKR/MonoplexKR-" + style + ".ttf")
# Change the font family name
SetFontNames(safe_family_name + "-" + style, family_name, "Monoplex Nerd Font " + style)
SetTTFName(0x409, 16, family_name)
Print("After changes:")
Print(" - Font name: " + $fontname)
Print(" - Family name: " + $familyname)
Print(" - Full name: " + $fullname)
# Save the merged font
Generate("build/" + safe_family_name + "-" + style + ".ttf")
Close()

