family_name = "Monoplex Nerd"
wide_family_name = "Monoplex Wide Nerd"

safe_family_name = "MonoplexNerd"
safe_wide_family_name = "MonoplexWideNerd"

#
# 넓은폭
#
style = "Bold"
Print("Merge " + wide_family_name + " " + style + "...")
# Open the base font (first font)
Open("build/PlemolJP35Console_NF/PlemolJP35ConsoleNF-" + style + ".ttf")
Print("Before changes:")
Print(" - Font name: " + $fontname)
Print(" - Family name: " + $familyname)
Print(" - Full name: " + $fullname)
# Merge the second font
MergeFonts("build/MonoplexKRWide/MonoplexKRWide-" + style + ".ttf")
# Change the font family name
SetFontNames(safe_wide_family_name + "-" + style, wide_family_name, "Monoplex Wide Nerd Font " + style)
SetTTFName(0x409, 16, wide_family_name)
Print("After changes:")
Print(" - Font name: " + $fontname)
Print(" - Family name: " + $familyname)
Print(" - Full name: " + $fullname)
# Save the merged font
Generate("build/" + safe_wide_family_name + "-" + style + ".ttf")
Close()

